-- AI-generated content cache, one row per note. Kept as a separate table from notesEntity so
-- generation (and its failure modes — no API key, offline, etc.) never touches the core note
-- read/write path. One row per note: switching templates overwrites the previous generation,
-- matching "regenerate on template switch" from the Note Template picker.
--
-- No FOREIGN KEY here: SQLite has `foreign_keys` enforcement OFF by default and this project's
-- drivers don't turn it on, so a constraint here would silently not cascade. Cleanup on note
-- deletion is done explicitly instead — see DeleteNoteById.
CREATE TABLE noteAiContentEntity(
    note_id INTEGER NOT NULL PRIMARY KEY,
    template TEXT NOT NULL DEFAULT 'classic',
    ai_note TEXT NOT NULL DEFAULT '',
    highlights TEXT NOT NULL DEFAULT '',
    summary TEXT NOT NULL DEFAULT '',
    tags TEXT NOT NULL DEFAULT '',
    generated_at INTEGER NOT NULL DEFAULT 0
);

getAiContentByNoteId:
SELECT * FROM noteAiContentEntity WHERE note_id = :note_id;

upsertAiContent:
INSERT OR REPLACE INTO noteAiContentEntity(note_id, template, ai_note, highlights, summary, tags, generated_at)
VALUES(:note_id, :template, :ai_note, :highlights, :summary, :tags, :generated_at);

deleteAiContentByNoteId:
DELETE FROM noteAiContentEntity WHERE note_id = :note_id;
