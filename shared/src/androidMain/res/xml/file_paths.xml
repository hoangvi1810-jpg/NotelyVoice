<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- For files in getExternalFilesDir("Music") -->
    <external-files-path
        name="recordings"
        path="Music/" />

    <!-- Optional: Add other paths if needed -->
    <cache-path
        name="internal_recordings"
        path="." />

    <!-- AttachmentPicker.android.kt copies picked images/videos/PDFs into filesDir/attachments;
         without this entry FileProvider.getUriForFile throws for anything under that directory. -->
    <files-path
        name="attachments"
        path="attachments/" />
</paths>